<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DualWAN.Dashboard</AssemblyName>
    <ApplicationIcon>Assets\DualWAN.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Languages\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\DualWAN.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
