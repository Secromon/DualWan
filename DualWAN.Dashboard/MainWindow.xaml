<Window x:Class="DualWAN.Dashboard.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DualWAN" Width="1200" Height="750" MinWidth="920" MinHeight="620" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI" SizeChanged="Window_SizeChanged" Closed="HistoryTooltip_Closed">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
   <Grid><Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0"><Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentBrush}"><TextBlock Text="⇄" Foreground="White" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="BrandText" Text="DualWAN" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,10">
     <RadioButton x:Name="NavDashboard" GroupName="Navigation" Tag="0" IsChecked="True" Style="{StaticResource NavButton}" Checked="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="17" Width="30"/><TextBlock x:Name="NavDashboardText" Text="Dashboard"/></StackPanel></RadioButton>
     <RadioButton x:Name="NavApplications" GroupName="Navigation" Tag="6" Style="{StaticResource NavButton}" Checked="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="17" Width="30"/><TextBlock x:Name="NavApplicationsText" Text="Applications"/></StackPanel></RadioButton>
     <RadioButton x:Name="NavHistory" GroupName="Navigation" Tag="4" Style="{StaticResource NavButton}" Checked="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="17" Width="30"/><TextBlock x:Name="NavHistoryText" Text="History"/></StackPanel></RadioButton>
     <RadioButton x:Name="NavStatistics" GroupName="Navigation" Tag="8" Style="{StaticResource NavButton}" Checked="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="17" Width="30"/><TextBlock x:Name="NavStatisticsText"/></StackPanel></RadioButton>
     
     <RadioButton x:Name="NavGroups" GroupName="Navigation" Tag="2" Style="{StaticResource NavButton}" Checked="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="17" Width="30"/><TextBlock x:Name="NavGroupsText" Text="Groups"/></StackPanel></RadioButton>
     <RadioButton x:Name="NavPresets" GroupName="Navigation" Tag="3" Style="{StaticResource NavButton}" Checked="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="17" Width="30"/><TextBlock x:Name="NavPresetsText" Text="Presets"/></StackPanel></RadioButton>
     <RadioButton x:Name="NavSettings" GroupName="Navigation" Tag="5" Style="{StaticResource NavButton}" Checked="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="17" Width="30"/><TextBlock x:Name="NavSettingsText" Text="Settings"/></StackPanel></RadioButton>
     <RadioButton x:Name="NavHelp" GroupName="Navigation" Tag="7" Style="{StaticResource NavButton}" Checked="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="?" FontSize="17" Width="30"/><TextBlock x:Name="NavHelpText"/></StackPanel></RadioButton>
    </StackPanel>
    <TextBlock Grid.Row="2" x:Name="VersionText" Text="DualWAN 1.0" Style="{StaticResource Caption}" Margin="20"/>
   </Grid>
  </Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><Grid Margin="28,0"><TextBlock x:Name="HeaderTitle" Text="Dashboard" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="ServiceActionMessage" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/><Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="16" Padding="12,7" Margin="0,0,10,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ServiceDot" Width="9" Height="9" Fill="{DynamicResource StatusDownBrush}" Margin="0,0,8,0"/><TextBlock x:Name="ServiceState" Text="Service Offline" FontWeight="SemiBold"/></StackPanel></Border><Button x:Name="ServiceControlButton" Content="Start Service" Click="ServiceControl_Click" Padding="12,6" MinHeight="30"/></StackPanel></Grid></Border>
   <TabControl Grid.Row="1" x:Name="MainTabs" Background="Transparent" BorderThickness="0" SelectionChanged="MainTabs_SelectionChanged"><TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
    <TabItem x:Name="DashboardTab" Header="Dashboard"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,20"><TextBlock x:Name="DashboardTitle" Text="Network overview" Style="{StaticResource PageTitle}"/><TextBlock x:Name="DashboardSubtitle" Text="Live status and routing activity" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock x:Name="Wan1Title" Text="WAN1" Style="{StaticResource CardTitle}"/><TextBlock x:Name="Wan1Address" Text="—" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><Border x:Name="Wan1StateBadge" HorizontalAlignment="Right" CornerRadius="11" Padding="10,5"><TextBlock x:Name="Wan1State" Text="UNKNOWN" Foreground="White" FontWeight="Bold"/></Border></Grid><Grid Grid.Row="1" Margin="0,24,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="Wan1RxLabel" Text="Download" Style="{StaticResource Caption}"/><TextBlock x:Name="Wan1RxRate" Text="—" Style="{StaticResource MetricLarge}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="Wan1TxLabel" Text="Upload" Style="{StaticResource Caption}"/><TextBlock x:Name="Wan1TxRate" Text="—" Style="{StaticResource MetricLarge}" Margin="0,4,0,0"/></StackPanel></Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="Wan1PingLabel" Text="Ping" Style="{StaticResource Caption}"/><TextBlock x:Name="Wan1Latency" Text="—" Style="{StaticResource Value}"/><TextBlock x:Name="Wan1LatencyRange" Text="—" Style="{StaticResource Caption}" Margin="0,4,0,0"/><TextBlock x:Name="Wan1LossLabel" Text="Probe loss" Style="{StaticResource Caption}" Margin="0,16,0,0"/><TextBlock x:Name="Wan1Loss" Text="—" Style="{StaticResource Value}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="Wan1UptimeLabel" Text="Uptime" Style="{StaticResource Caption}"/><TextBlock x:Name="Wan1Uptime" Text="—" Style="{StaticResource Value}"/><TextBlock x:Name="Wan1TotalsLabel" Text="Session totals" Style="{StaticResource Caption}" Margin="0,16,0,0"/><TextBlock x:Name="Wan1RxTotal" Text="RX —" Style="{StaticResource Value}"/><TextBlock x:Name="Wan1TxTotal" Text="TX —" Style="{StaticResource Value}"/></StackPanel></Grid></Grid></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock x:Name="Wan2Title" Text="WAN2" Style="{StaticResource CardTitle}"/><TextBlock x:Name="Wan2Address" Text="—" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><Border x:Name="Wan2StateBadge" HorizontalAlignment="Right" CornerRadius="11" Padding="10,5"><TextBlock x:Name="Wan2State" Text="UNKNOWN" Foreground="White" FontWeight="Bold"/></Border></Grid><Grid Grid.Row="1" Margin="0,24,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="Wan2RxLabel" Text="Download" Style="{StaticResource Caption}"/><TextBlock x:Name="Wan2RxRate" Text="—" Style="{StaticResource MetricLarge}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="Wan2TxLabel" Text="Upload" Style="{StaticResource Caption}"/><TextBlock x:Name="Wan2TxRate" Text="—" Style="{StaticResource MetricLarge}" Margin="0,4,0,0"/></StackPanel></Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="Wan2PingLabel" Text="Ping" Style="{StaticResource Caption}"/><TextBlock x:Name="Wan2Latency" Text="—" Style="{StaticResource Value}"/><TextBlock x:Name="Wan2LatencyRange" Text="—" Style="{StaticResource Caption}" Margin="0,4,0,0"/><TextBlock x:Name="Wan2LossLabel" Text="Probe loss" Style="{StaticResource Caption}" Margin="0,16,0,0"/><TextBlock x:Name="Wan2Loss" Text="—" Style="{StaticResource Value}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="Wan2UptimeLabel" Text="Uptime" Style="{StaticResource Caption}"/><TextBlock x:Name="Wan2Uptime" Text="—" Style="{StaticResource Value}"/><TextBlock x:Name="Wan2TotalsLabel" Text="Session totals" Style="{StaticResource Caption}" Margin="0,16,0,0"/><TextBlock x:Name="Wan2RxTotal" Text="RX —" Style="{StaticResource Value}"/><TextBlock x:Name="Wan2TxTotal" Text="TX —" Style="{StaticResource Value}"/></StackPanel></Grid></Grid></Border>
     </Grid>
     <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="20,15"><Grid><TextBlock x:Name="ServiceUptime" Text="Service uptime —" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="FlowSummary" Text="Active —  •  Routed —  •  Failed —" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid></Border>
    </Grid></ScrollViewer></TabItem>
    <TabItem x:Name="RulesTab" Header="Rules" Visibility="Collapsed"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock x:Name="RulesTitle" Text="Application rules" Style="{StaticResource PageTitle}"/><TextBlock x:Name="RulesSubtitle" Text="Policies apply to new flows only" Style="{StaticResource Caption}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="RefreshRulesButton" Content="Refresh" Click="RefreshRules_Click" Margin="0,0,10,0"/><Button x:Name="AddRuleButton" Content="Add rule" Click="AddRule_Click" Style="{StaticResource PrimaryButton}"/></StackPanel></Grid><Border Grid.Row="1" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="7" Padding="12,8" Margin="0,18,0,12"><TextBlock x:Name="RulesStatus" Text="Loading rules…" Style="{StaticResource Caption}"/></Border><DataGrid Grid.Row="2" x:Name="RulesGrid" Style="{StaticResource GridStyle}"><DataGrid.Columns><DataGridTextColumn x:Name="RuleApplicationColumn" Header="Application" Binding="{Binding Process}" Width="2*"/><DataGridTextColumn Header="WAN" Binding="{Binding WanDisplay}" Width="2*"/><DataGridTextColumn x:Name="RuleModeColumn" Header="Mode" Binding="{Binding Mode}" Width="*"/><DataGridTemplateColumn x:Name="RuleStatusColumn" Header="Status" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource StatusBadge}"><TextBlock Text="{Binding EnabledText}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn x:Name="RuleActionsColumn" Header="Actions" Width="230"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="" FontFamily="Segoe Fluent Icons" ToolTip="{DynamicResource tooltip.edit}" Click="EditRule_Click" Tag="{Binding}" Padding="9,4" Margin="0,0,6,0"/><Button Content="" FontFamily="Segoe Fluent Icons" ToolTip="{DynamicResource tooltip.toggle}" Click="ToggleRule_Click" Tag="{Binding}" Padding="9,4" Margin="0,0,6,0"/><Button Content="" FontFamily="Segoe Fluent Icons" ToolTip="{DynamicResource tooltip.delete}" Click="DeleteRule_Click" Tag="{Binding}" Padding="9,4" Style="{StaticResource DangerButton}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><TextBlock Grid.Row="3" x:Name="RulesHelp" Style="{StaticResource Caption}" Margin="0,12,0,0" Text="STRICT uses only the selected WAN. FAILOVER allows automatic fallback."/></Grid></TabItem>
    <TabItem x:Name="GroupsTab"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock x:Name="GroupsTitle" Style="{StaticResource PageTitle}"/><TextBlock x:Name="GroupsSubtitle" Style="{StaticResource Caption}" TextWrapping="Wrap"/></StackPanel>
<DockPanel Grid.Row="1" Margin="0,12"><Button x:Name="AddGroupButton" Content="+" DockPanel.Dock="Right" Click="AddGroup_Click" Style="{StaticResource PrimaryButton}"/><Button x:Name="RefreshGroupsButton" DockPanel.Dock="Right" Click="RefreshGroups_Click" Style="{StaticResource RowActionButton}" Margin="0,0,8,0"/><TextBlock x:Name="GroupsStatus" VerticalAlignment="Center" Style="{StaticResource Caption}"/></DockPanel>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Card}" Padding="0"><DockPanel><TextBlock x:Name="GroupsSearchLabel" DockPanel.Dock="Top" Margin="8,8,8,0" Style="{StaticResource Caption}"/><TextBox x:Name="GroupsSearch" DockPanel.Dock="Top" Margin="8" TextChanged="GroupsSearch_TextChanged"/><ListBox x:Name="GroupsGrid" Background="{DynamicResource SurfaceBrush}" BorderThickness="0" ItemContainerStyle="{StaticResource RunningAppListItem}" SelectionChanged="GroupsGrid_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding EnabledText}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding PolicyDisplay}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ApplicationsDisplay}" Style="{StaticResource Caption}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
<Border Grid.Column="2" Style="{StaticResource Card}"><Grid><TextBlock x:Name="GroupsEmpty" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/><ScrollViewer x:Name="GroupEditor" Background="{DynamicResource SurfaceBrush}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="2,0,8,2">
<TextBlock x:Name="GroupEditorTitle" Style="{StaticResource PageTitle}" Margin="0,0,0,12"/><CheckBox x:Name="GroupEnabledEdit" Checked="GroupEditor_Changed" Unchecked="GroupEditor_Changed" Margin="0,0,0,10"/>
<TextBlock x:Name="GroupNameLabel" Style="{StaticResource Caption}"/><TextBox x:Name="GroupNameEdit" TextChanged="GroupEditor_Changed" Margin="0,4,0,12"/>
<TextBlock x:Name="GroupWanLabel" Style="{StaticResource Caption}"/><ComboBox x:Name="GroupWanEdit" DisplayMemberPath="Display" SelectedValuePath="Id" SelectionChanged="GroupEditor_Changed" Margin="0,4,0,12"/>
<TextBlock x:Name="GroupModeLabel" Style="{StaticResource Caption}"/><ComboBox x:Name="GroupModeEdit" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="GroupEditor_Changed" Margin="0,4,0,12"/>
<DockPanel Margin="0,5,0,8"><Button x:Name="GroupAddAppsButton" DockPanel.Dock="Right" Click="GroupAddApps_Click" Style="{StaticResource RowActionButton}"/><TextBlock x:Name="GroupAppsLabel" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel><StackPanel x:Name="GroupMembersPanel"/>
<DockPanel Margin="0,18,0,0"><Button x:Name="GroupDeleteButton" DockPanel.Dock="Right" Click="DeleteGroup_Click" Style="{StaticResource DangerButton}"/><Button x:Name="GroupSaveButton" DockPanel.Dock="Left" Click="GroupSave_Click" Style="{StaticResource PrimaryButton}"/></DockPanel></StackPanel></ScrollViewer></Grid></Border></Grid>
<TextBlock Grid.Row="3" x:Name="GroupsHelp" Style="{StaticResource Caption}" Margin="0,12,0,0"/></Grid></TabItem>
    <TabItem x:Name="PresetsTab" Header="Presets"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="PresetsTitle" Text="Policy presets" Style="{StaticResource PageTitle}"/><TextBlock x:Name="PresetsSubtitle" Text="Apply a ready-made group routing strategy" Style="{StaticResource Caption}"/></StackPanel><Border Grid.Row="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="14" Margin="0,18"><TextBlock x:Name="CurrentPresetText" Text="Current preset: Custom" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></Border><UniformGrid Grid.Row="2" Columns="2"><Border Style="{StaticResource Card}" Margin="0,0,9,9"><StackPanel><TextBlock x:Name="Preset1Title" Text="5G Priority" Style="{StaticResource CardTitle}"/><TextBlock x:Name="Preset1Description" Text="Interactive and high bandwidth groups use WAN2 with fallback." TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,8,0,16"/><Button x:Name="Preset1Apply" Content="Apply" Tag="5g-priority" Click="Preset_Click" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="9,0,0,9"><StackPanel><TextBlock x:Name="Preset2Title" Text="Save 5G" Style="{StaticResource CardTitle}"/><TextBlock x:Name="Preset2Description" Text="Enabled groups prefer WAN1 and use WAN2 as fallback." TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,8,0,16"/><Button x:Name="Preset2Apply" Content="Apply" Tag="save-5g" Click="Preset_Click" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,9,9,0"><StackPanel><TextBlock x:Name="Preset3Title" Text="Only 5G" Style="{StaticResource CardTitle}"/><TextBlock x:Name="Preset3Description" Text="Enabled groups use WAN2 in STRICT mode." TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,8,0,16"/><Button x:Name="Preset3Apply" Content="Apply" Tag="only-5g" Click="Preset_Click" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="9,9,0,0"><StackPanel><TextBlock x:Name="Preset4Title" Text="Custom" Style="{StaticResource CardTitle}"/><TextBlock x:Name="Preset4Description" Text="Keep the current manual group configuration." TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,8,0,16"/><Button x:Name="Preset4Apply" Content="Apply" Tag="custom" Click="Preset_Click" HorizontalAlignment="Left"/></StackPanel></Border></UniformGrid></Grid></ScrollViewer></TabItem>
    <TabItem x:Name="HistoryTab" Header="History">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
      <TextBlock x:Name="HistoryTitle" Style="{StaticResource PageTitle}"/>
      <Border Style="{StaticResource Card}" Padding="14" Margin="0,16"><StackPanel Orientation="Horizontal">
       <TextBlock x:Name="HistoryRangeLabel" VerticalAlignment="Center" Margin="0,0,8,0"/>
       <ComboBox x:Name="HistoryRange" Width="110" SelectedIndex="0" SelectionChanged="HistoryFilter_SelectionChanged"><ComboBoxItem Content="1h"/><ComboBoxItem Content="24h"/><ComboBoxItem Content="7d"/><ComboBoxItem Content="30d"/></ComboBox>
       <Button x:Name="HistoryRefreshButton" Click="HistoryRefresh_Click" Margin="16,0,0,0"/>
       <TextBlock x:Name="HistoryStatus" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="18,0,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16"><StackPanel>
       <TextBlock x:Name="HistoryWan1Title" Style="{StaticResource SectionTitle}" Text="WAN1"/>
       <TextBlock x:Name="HistoryWan1Adapter" Style="{StaticResource Caption}" Margin="0,3,0,10"/>
       <TextBlock x:Name="HistoryWan1Empty" Style="{StaticResource Caption}" Visibility="Collapsed" Margin="0,0,0,8"/>
       <UniformGrid x:Name="HistoryWan1Stats" Columns="4" Margin="0,0,0,14"/>
       <TextBlock x:Name="HistoryWan1TrafficTitle" Style="{StaticResource CardTitle}"/>
       <Canvas x:Name="HistoryWan1Traffic" Height="190" Margin="0,8,0,16" Background="{DynamicResource SurfaceSecondaryBrush}" SizeChanged="HistoryChart_SizeChanged" MouseMove="HistoryChart_MouseMove" MouseLeave="HistoryChart_MouseLeave" IsVisibleChanged="HistoryChart_IsVisibleChanged"/>
       <TextBlock x:Name="HistoryWan1QualityTitle" Style="{StaticResource CardTitle}"/>
       <Canvas x:Name="HistoryWan1Quality" Height="190" Margin="0,8,0,0" Background="{DynamicResource SurfaceSecondaryBrush}" SizeChanged="HistoryChart_SizeChanged" MouseMove="HistoryChart_MouseMove" MouseLeave="HistoryChart_MouseLeave" IsVisibleChanged="HistoryChart_IsVisibleChanged"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16"><StackPanel>
       <TextBlock x:Name="HistoryWan2Title" Style="{StaticResource SectionTitle}" Text="WAN2"/>
       <TextBlock x:Name="HistoryWan2Adapter" Style="{StaticResource Caption}" Margin="0,3,0,10"/>
       <TextBlock x:Name="HistoryWan2Empty" Style="{StaticResource Caption}" Visibility="Collapsed" Margin="0,0,0,8"/>
       <UniformGrid x:Name="HistoryWan2Stats" Columns="4" Margin="0,0,0,14"/>
       <TextBlock x:Name="HistoryWan2TrafficTitle" Style="{StaticResource CardTitle}"/>
       <Canvas x:Name="HistoryWan2Traffic" Height="190" Margin="0,8,0,16" Background="{DynamicResource SurfaceSecondaryBrush}" SizeChanged="HistoryChart_SizeChanged" MouseMove="HistoryChart_MouseMove" MouseLeave="HistoryChart_MouseLeave" IsVisibleChanged="HistoryChart_IsVisibleChanged"/>
       <TextBlock x:Name="HistoryWan2QualityTitle" Style="{StaticResource CardTitle}"/>
       <Canvas x:Name="HistoryWan2Quality" Height="190" Margin="0,8,0,0" Background="{DynamicResource SurfaceSecondaryBrush}" SizeChanged="HistoryChart_SizeChanged" MouseMove="HistoryChart_MouseMove" MouseLeave="HistoryChart_MouseLeave" IsVisibleChanged="HistoryChart_IsVisibleChanged"/>
      </StackPanel></Border>
     </StackPanel></ScrollViewer>
    </TabItem>
    <TabItem x:Name="SettingsTab" Header="Settings"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="SettingsTitle" Text="Settings" Style="{StaticResource PageTitle}"/><Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="AppearanceTitle" Text="Appearance" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="AppearanceDescription" Text="Choose how DualWAN looks on this account." Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="ThemeLabel" Text="Theme" Style="{StaticResource Caption}"/><ComboBox x:Name="ThemeSelect" SelectionChanged="ThemeSelect_SelectionChanged" SelectedValuePath="Tag" Margin="0,5,0,0"><ComboBoxItem x:Name="ThemeSystem" Content="System" Tag="System"/><ComboBoxItem x:Name="ThemeLight" Content="Light" Tag="Light"/><ComboBoxItem x:Name="ThemeDark" Content="Dark" Tag="Dark"/></ComboBox></StackPanel></Grid></Border><Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="LanguageSectionTitle" Text="Language" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="LanguageDescription" Text="External language packs are loaded at startup." Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="LanguageLabel" Text="Language" Style="{StaticResource Caption}"/><ComboBox x:Name="LanguageSelect" SelectionChanged="LanguageSelect_SelectionChanged" DisplayMemberPath="DisplayName" SelectedValuePath="Code" Margin="0,5,0,0"/></StackPanel></Grid></Border><Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10"><StackPanel><TextBlock x:Name="WanConfigurationTitle" Text="WAN configuration" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="WanConfigurationDescription" Text="Select both network interfaces before routing can start." Style="{StaticResource Caption}" Margin="0,4,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="WAN1" Style="{StaticResource CardTitle}"/><TextBlock x:Name="Wan1InterfaceLabel" Text="Interface" Style="{StaticResource Caption}" Margin="0,10,0,4"/><ComboBox x:Name="Wan1InterfaceSelect" DisplayMemberPath="Display" SelectedValuePath="Id" MinWidth="230"/><TextBlock x:Name="Wan1FriendlyLabel" Text="Friendly name" Style="{StaticResource Caption}" Margin="0,10,0,4"/><TextBox x:Name="Wan1FriendlyName" Text="WAN1" MaxLength="64"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="WAN2" Style="{StaticResource CardTitle}"/><TextBlock x:Name="Wan2InterfaceLabel" Text="Interface" Style="{StaticResource Caption}" Margin="0,10,0,4"/><ComboBox x:Name="Wan2InterfaceSelect" DisplayMemberPath="Display" SelectedValuePath="Id" MinWidth="230"/><TextBlock x:Name="Wan2FriendlyLabel" Text="Friendly name" Style="{StaticResource Caption}" Margin="0,10,0,4"/><TextBox x:Name="Wan2FriendlyName" Text="WAN2" MaxLength="64"/></StackPanel></Grid><TextBlock x:Name="WanConfigurationStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/><Button x:Name="SaveWanConfigurationButton" Content="Save WAN configuration" Click="SaveWanConfiguration_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border><Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="HistoricalSettingsTitle" Text="Historical Data" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="StorageStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,24,0"/><Button x:Name="CleanHistoryButton" Content="Clean old data now" Click="CleanHistory_Click" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="RetentionLabel" Text="Retention" Style="{StaticResource Caption}"/><ComboBox x:Name="RetentionSelect" Margin="0,5,0,10" SelectedIndex="1"><ComboBoxItem Content="7 days" Tag="7"/><ComboBoxItem Content="30 days" Tag="30"/><ComboBoxItem Content="90 days" Tag="90"/><ComboBoxItem Content="180 days" Tag="180"/><ComboBoxItem Content="365 days" Tag="365"/><ComboBoxItem Content="Custom" Tag="custom"/><ComboBoxItem Content="Keep indefinitely" Tag="unlimited"/></ComboBox><TextBlock x:Name="CustomRetentionLabel" Text="Custom retention days" Style="{StaticResource Caption}"/><TextBox x:Name="CustomRetentionDays" Text="30" Margin="0,5,0,10"/><TextBlock x:Name="MaximumSizeLabel" Text="Maximum database size" Style="{StaticResource Caption}"/><ComboBox x:Name="MaximumSizeSelect" Margin="0,5,0,14" SelectedIndex="2"><ComboBoxItem Content="250 MB" Tag="262144000"/><ComboBoxItem Content="500 MB" Tag="524288000"/><ComboBoxItem Content="1 GB" Tag="1073741824"/><ComboBoxItem Content="2 GB" Tag="2147483648"/><ComboBoxItem Content="5 GB" Tag="5368709120"/><ComboBoxItem Content="Unlimited" Tag="unlimited"/></ComboBox><Button x:Name="SaveSettingsButton" Content="Save settings" Click="SaveSettings_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/></StackPanel></Grid></Border><CheckBox x:Name="StartupCheck" Grid.Row="5" Content="Start DualWAN Dashboard with Windows" Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed" Margin="0,10"/><Border Grid.Row="6" Style="{StaticResource Card}" Margin="0,10,0,0"><StackPanel><TextBlock x:Name="AboutTitle" Text="About" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="AboutVersion" Text="Version" Style="{StaticResource Caption}" Margin="0,6,0,0"/><TextBlock x:Name="AboutText" Text="DualWAN · Local multi-WAN policy manager" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></Border></Grid></ScrollViewer></TabItem>
    <TabItem x:Name="ApplicationsTab" Header="Applications">
     <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock x:Name="ApplicationsTitle" Text="Applications" Style="{StaticResource PageTitle}"/><TextBlock x:Name="ApplicationsSubtitle" Text="Choose where each application connects" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel>
       <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="18,0,0,0">
        <Button x:Name="AddApplicationButton" Content="Add application" Click="AddApplication_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
        <Button x:Name="CreatePackagesButton" Click="CreatePackages_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
        <Button x:Name="NetworkActivityButton" Click="NetworkActivity_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"/>
       </WrapPanel>
      </Grid>
      <StackPanel Grid.Row="1" Margin="0,18,0,10">
       <Grid HorizontalAlignment="Left" Width="320" Margin="0,0,0,12">
        <TextBox x:Name="ApplicationsSearch" TextChanged="ApplicationsSearch_TextChanged" Padding="10,6,32,6"/>
        <TextBlock x:Name="ApplicationsSearchHint" Text="Search applications..." Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0,35,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <Button Content="×" Click="ClearApplicationsSearch_Click" Width="27" Height="27" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"/>
       </Grid>
       <TextBlock x:Name="ApplicationsStatus" Text="Configured applications" Style="{StaticResource SectionTitle}"/>
       <TextBlock x:Name="ApplicationsNotice" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
      </StackPanel>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel>
       <TextBlock x:Name="ApplicationsEmpty" Text="No applications configured" Style="{StaticResource Caption}" Margin="0,12"/>
       <TextBlock x:Name="ApplicationsSearchEmpty" Text="No applications match the search." Style="{StaticResource Caption}" Margin="0,12" Visibility="Collapsed"/>
       <ItemsControl x:Name="ApplicationsList" AlternationCount="2"><ItemsControl.ItemTemplate><DataTemplate>
        <Border Style="{StaticResource ApplicationRowCard}" BorderThickness="1" CornerRadius="6" Padding="10,7" MinHeight="54" Margin="0,0,0,4">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*" MinWidth="220"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid Width="32" Height="32" VerticalAlignment="Center"><TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Icon}" Width="30" Height="30" Stretch="Uniform"/></Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
           <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{Binding Path}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{Binding Group}" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><DataTrigger Binding="{Binding Group}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
           <TextBlock Text="{Binding Missing}" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><DataTrigger Binding="{Binding Missing}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          </StackPanel>
          <StackPanel Grid.Column="2" MaxWidth="175" VerticalAlignment="Center" Margin="0,0,10,0">
           <TextBlock Text="{Binding Preference}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
           <TextBlock Text="{Binding Origin}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{DynamicResource apps.openFileLocation}" IsEnabled="{Binding CanOpenLocation}" Click="OpenApplicationLocation_Click" Tag="{Binding}" Style="{StaticResource RowActionButton}" Padding="9,4" MinHeight="28" Margin="0,0,6,0"/><Button Content="{DynamicResource apps.edit}" Click="EditApplication_Click" Tag="{Binding}" Style="{StaticResource RowActionButton}" Padding="9,4" MinHeight="28" Margin="0,0,6,0"/><Button Content="{DynamicResource apps.remove}" Click="RemoveApplication_Click" Tag="{Binding}" Style="{StaticResource DangerButton}" Padding="9,4" MinHeight="28"/></StackPanel>
         </Grid>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <TextBlock x:Name="PackagesTitle" Style="{StaticResource SectionTitle}" Margin="0,22,0,8"/><StackPanel x:Name="PackageCards"/>
      </StackPanel></ScrollViewer>
     </Grid>
    </TabItem>
    <TabItem x:Name="HelpTab">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="28">
       <TextBlock x:Name="HelpTitle" Style="{StaticResource PageTitle}"/>
       <ItemsControl x:Name="HelpSections">
        <ItemsControl.ItemTemplate><DataTemplate>
         <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
          <StackPanel>
           <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>
           <TextBlock Text="{Binding Body}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem x:Name="StatisticsTab">
     <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid><TextBlock x:Name="StatisticsTitle" Style="{StaticResource PageTitle}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="Stats1h" Tag="1h" Content="1h" Click="StatsPeriod_Click" Style="{StaticResource RowActionButton}" Margin="0,0,5,0"/><Button x:Name="Stats24h" IsEnabled="False" Tag="24h" Content="24h" Click="StatsPeriod_Click" Style="{StaticResource RowActionButton}" Margin="0,0,5,0"/><Button x:Name="Stats7d" IsEnabled="False" Tag="7d" Content="7d" Click="StatsPeriod_Click" Style="{StaticResource RowActionButton}" Margin="0,0,5,0"/><Button x:Name="Stats30d" IsEnabled="False" Tag="30d" Content="30d" Click="StatsPeriod_Click" Style="{StaticResource RowActionButton}"/><Button x:Name="StatsRefresh" Click="StatsRefresh_Click" Style="{StaticResource RowActionButton}" Margin="12,0,0,0"/></StackPanel></Grid>
      <TextBlock x:Name="StatsCoverage" Grid.Row="1" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,12"/>
      <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="StatsRetentionLabel" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="StatsRetention" Width="115" SelectionChanged="StatsRetention_SelectionChanged"><ComboBoxItem Tag="60"/><ComboBoxItem Tag="1440"/><ComboBoxItem Tag="10080"/><ComboBoxItem Tag="43200"/></ComboBox><TextBlock x:Name="StatsRetentionWarning" MaxWidth="330" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0,0,0"/></StackPanel><TextBlock x:Name="StatsStatus" Grid.Column="1" Style="{StaticResource Caption}" VerticalAlignment="Center"/></Grid>
      <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" MinWidth="250"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.4*" MinWidth="310"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}" Padding="12"><DockPanel><TextBlock x:Name="StatsTopTitle" DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/><TextBlock x:Name="StatsEmpty" DockPanel.Dock="Top" Style="{StaticResource Caption}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,8"/><ListBox x:Name="StatsTopList" Background="{DynamicResource SurfaceBrush}" BorderThickness="0" ItemContainerStyle="{StaticResource RunningAppListItem}" SelectionChanged="StatsTopList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Grid Margin="2,5"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image Source="{Binding Icon}" Width="20" Height="20" VerticalAlignment="Center"/><StackPanel Grid.Column="1" ToolTip="{Binding AppKey}"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding TrafficText}" Style="{StaticResource Caption}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding TotalText}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="8,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
       <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="StatsDetailTitle" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="StatsDetailPath" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,3,0,10"/><TextBlock x:Name="StatsTotals" Style="{StaticResource Body}" TextWrapping="Wrap"/><TextBlock x:Name="StatsFlows" Style="{StaticResource Caption}" Margin="0,5,0,12"/><TextBlock x:Name="StatsWanTitle" Style="{StaticResource CardTitle}"/><ItemsControl x:Name="StatsWanList" Margin="0,6,0,12"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Body}" Margin="0,2" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="StatsChartTitle" Style="{StaticResource CardTitle}"/><Canvas x:Name="StatsChart" Height="210" Background="{DynamicResource SurfaceSecondaryBrush}" Margin="0,8,0,0" SizeChanged="StatsChart_SizeChanged" MouseMove="StatsChart_MouseMove" MouseLeave="StatsChart_MouseLeave"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Ellipse Fill="{DynamicResource HistoryDownload}" Width="8" Height="8" Margin="0,0,5,0"/><TextBlock x:Name="StatsDownloadLegend" Style="{StaticResource Caption}"/><Ellipse Fill="{DynamicResource HistoryUpload}" Width="8" Height="8" Margin="14,0,5,0"/><TextBlock x:Name="StatsUploadLegend" Style="{StaticResource Caption}"/></StackPanel><TextBlock x:Name="StatsChartEmpty" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></ScrollViewer></Border>
      </Grid>
     </Grid>
    </TabItem>
   </TabControl>
  </Grid>
 </Grid>
</Window>


